# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated design tokens (pnpm tokens:build)
/src/styles/tokens.css

# playwright
/test-results/
/playwright-report/
/.lighthouseci/
/lighthouse-report/
/blob-report/

# contact form dev outbox
/.outbox/

# local tool settings
/.claude/settings.local.json
/.claude/launch.json
/.claude/worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
