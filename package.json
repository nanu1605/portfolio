{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "pnpm tokens:build",
    "dev": "next dev",
    "prebuild": "pnpm tokens:build && pnpm check:content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:budget": "playwright test --grep @budget --workers=1 --project=desktop-chromium --project=phone-android",
    "tokens:build": "tsx scripts/tokens-build.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:content": "tsx scripts/check-content.ts",
    "format": "prettier --write .",
    "prepare": "husky",
    "images": "tsx scripts/images.ts",
    "capture:menumesh": "tsx scripts/capture/menumesh.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@react-pdf/renderer": "^4.9.0",
    "@types/mdx": "^2.0.14",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.1"
}
